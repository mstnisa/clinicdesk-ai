{
  "name": "ClinicDesk 03 - GTM outbound (approved only) + follow-up",
  "nodes": [
    {
      "parameters": {
        "content": "## Outbound\nThe GTM pipeline queues drafts as **pending_approval**. A human approves them in the dashboard. This workflow only fetches **approved** drafts, sends them with Gmail and marks them sent. The API refuses to mark anything as sent that was not approved.\n\nFollow-up: 3 days after sending, if the contact has not replied, a follow-up draft is queued for approval (never sent automatically).",
        "width": 460,
        "height": 260
      },
      "id": "9fb7cdd5-d41a-5b1c-b073-a0cce73b2db1",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -340
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10-17 * * 6,0-4"
            }
          ]
        }
      },
      "id": "3972451c-2149-5261-8a60-a822f3812a03",
      "name": "Weekdays 10:00-17:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CLINICDESK_API_URL || 'http://agent:8000' }}/api/admin/outreach?status=approved",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.CLINICDESK_ADMIN_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "51eaffcb-c806-5304-b0db-9d149828cb3c",
      "name": "Approved drafts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "7848f649-3dd2-4dab-b1dd-f699224d18d6",
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "50262ae9-27b9-5bcf-86b0-d1a5ae5fc1d0",
      "name": "Has email",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "0f143130-ab75-5f71-a728-db170b680eb6",
      "name": "Send email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CLINICDESK_API_URL || 'http://agent:8000' }}/api/admin/outreach/{{ $('Has email').item.json.id }}/sent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.CLINICDESK_ADMIN_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e4e0df17-404b-5088-9e28-ff9cec18ab14",
      "name": "Mark sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 11 * * 6,0-4"
            }
          ]
        }
      },
      "id": "2793440d-766d-5be1-8b6e-0b1bbdf365cb",
      "name": "Daily 11:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        260
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CLINICDESK_API_URL || 'http://agent:8000' }}/api/admin/outreach?status=sent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.CLINICDESK_ADMIN_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "571fb680-7b51-54d0-a776-6926a33eb289",
      "name": "Sent drafts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const cutoff = DateTime.now().minus({ days: 3 });\nreturn $input.all().filter(i => i.json.email && DateTime.fromISO(i.json.updated_at) < cutoff);"
      },
      "id": "ae1cc446-e644-5ada-85f9-1d4631fcbc8c",
      "name": "Sent 3+ days ago",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        260
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "46c2f861-7f13-5494-b20f-91c543ebbd70",
      "name": "One contact at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        660,
        260
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "returnAll": false,
        "limit": 1,
        "filters": {
          "q": "=from:{{ $('One contact at a time').item.json.email }} newer_than:14d"
        }
      },
      "id": "c5c9ee76-889e-58b1-9539-efd3998d69ca",
      "name": "Replies from contact",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        880,
        340
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c75aaeac-0296-4eff-bf0f-ab4aa738e4d9",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ece40bfa-ad80-542d-a239-38b62757abb0",
      "name": "No reply yet",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        340
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CLINICDESK_API_URL || 'http://agent:8000' }}/api/admin/outreach",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.CLINICDESK_ADMIN_TOKEN }}"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  company: $('One contact at a time').item.json.company, website: $('One contact at a time').item.json.website,\n  city: $('One contact at a time').item.json.city, email: $('One contact at a time').item.json.email,\n  icp_score: $('One contact at a time').item.json.icp_score, icp_reasons: 'Follow-up',\n  subject: 'Re: ' + $('One contact at a time').item.json.subject,\n  body: 'Hi again,\\n\\nJust checking whether a short demo of ClinicDesk AI would be useful for your team. Happy to work around your schedule.\\n\\nBest regards,\\nMst. Awalunnisa' }) }}"
      },
      "id": "42158632-dc75-5a47-81b9-79b6125f7aa4",
      "name": "Queue follow-up draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CLINICDESK_API_URL || 'http://agent:8000' }}/api/admin/outreach/{{ $('One contact at a time').item.json.id }}/followed_up",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.CLINICDESK_ADMIN_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "33fd429c-02b0-5fd3-929d-64f2fc796a9e",
      "name": "Mark followed up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        300
      ]
    }
  ],
