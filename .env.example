# ---- Model provider ----------------------------------------------------
# mock = offline demo, no key needed. Or: gemini | openai | anthropic | groq
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Optional overrides of the default small/main models in agent/app/llm/pricing.yaml
SMALL_MODEL=
MAIN_MODEL=
USD_TO_BDT=122

# ---- Security -----------------------------------------------------------
# Long random strings, e.g.  openssl rand -hex 24
# "change-me" is accepted ONLY in mock mode; with a real provider the agent refuses to start.
ADMIN_TOKEN=change-me
POSTGRES_PASSWORD=change-me-too
N8N_ENCRYPTION_KEY=change-me-three
RATE_LIMIT_PER_MINUTE=20
# Max model calls per day (0 = no cap). Past the cap the free offline model answers.
DAILY_LLM_CALL_BUDGET=0
# true only for a public demo with fake data (allows the shared demo admin token)
DEMO_MODE=false
# Shared secret the agent sends to n8n (X-Webhook-Secret); n8n workflow 01 drops requests without it
N8N_WEBHOOK_SECRET=
# 127.0.0.1 = ports reachable only from this machine (recommended; Caddy serves the public HTTPS)
BIND_ADDRESS=127.0.0.1

# ---- WhatsApp Business Cloud API (optional) -----------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=clinicdesk-verify
# Required once WHATSAPP_TOKEN is set: unsigned webhooks are rejected
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ---- n8n integrations (optional) ----------------------------------------
CLINICDESK_SHEET_ID=
CLINICDESK_CALENDAR_ID=            # email-style calendar ID, e.g. you@gmail.com (n8n rejects "primary")
CLINICDESK_ALERT_EMAIL=
CLINIC_ADDRESS=House 12, Road 7, Dhanmondi, Dhaka 1205
# GTM pipeline with live Google Maps data
APIFY_TOKEN=

# ---- VPS / HTTPS (docker compose --profile https) -----------------------
AGENT_DOMAIN=
N8N_DOMAIN=
N8N_HOST=localhost
N8N_PUBLIC_URL=http://localhost:5678/
